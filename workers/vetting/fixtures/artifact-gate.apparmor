# Fixed harmless-fixture policy. No generated file receives read/map/execute.
# Baseline and source trees are root owned; source is also a read-only mount.
profile slop-artifact-fixture flags=(mediate_deleted) {
  /usr/bin/python3{,.12} rix,
  /usr/bin/true r,
  /usr/lib/** mr,
  /lib/** mr,
  /etc/ld.so.cache r,
  /etc/localtime r,
  /etc/python3*/** r,
  /opt/slop/source/** r,
  /proc/*/attr/current r,
  /dev/null rw,
  /dev/urandom r,
  /root/slop-output.log w,
  /root/slop-after-collector.log w,
  /tmp/slop-quarantine/ w,
  /tmp/slop-quarantine/** w,
  audit deny /tmp/slop-quarantine/** rmlx,
  ptrace (readby, tracedby) peer=unconfined,
  signal (receive) peer=unconfined,
  signal (send, receive) peer=slop-artifact-fixture,
}
